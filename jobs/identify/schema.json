{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "identify output",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "reason", "marks"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symptom_id", "confidence"],
        "properties": {
          "symptom_id": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "reason": { "type": "string" },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "symptom_id", "cue", "box"],
        "properties": {
          "frame": { "type": "integer" },
          "symptom_id": { "type": "string" },
          "cue": { "type": "integer" },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "type": "integer" },
              "h": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
