{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "hazard",
    "title",
    "steps",
    "checks",
    "figures",
    "question",
    "options",
    "marks"
  ],
  "properties": {
    "kind": {
      "enum": [
        "answer",
        "ask",
        "not_found"
      ]
    },
    "hazard": {
      "enum": [
        "none",
        "brakes",
        "fuel",
        "hot_coolant",
        "running_engine",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "ref",
          "quote"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "why", "likelihood", "minutes"],
        "properties": {
          "text": { "type": "string" },
          "why": { "type": "string" },
          "likelihood": { "enum": ["high", "medium", "low"] },
          "minutes": { "type": "integer" }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "caption",
          "box",
          "parts"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "printed", "asked", "box"],
              "properties": {
                "name": { "type": "string" },
                "printed": { "type": "string" },
                "asked": { "type": "boolean" },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "w", "h"],
                  "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "w": { "type": "integer" }, "h": { "type": "integer" } }
                }
              }
            }
          },
          "caption": {
            "type": "string"
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "step",
          "label",
          "box"
        ],
        "properties": {
          "frame": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
