{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "symptom.schema.json",
  "title": "Symptom (decision tree)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "visual_cues", "steps", "escalate_after_steps"],
  "properties": {
    "id": { "$ref": "#/definitions/slug" },
    "title": { "type": "string", "minLength": 1 },
    "sample": {
      "description": "true = placeholder content, not real knowledge. Must never ship in a demo.",
      "type": "boolean"
    },
    "visual_cues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "escalate_after_steps": { "type": "integer", "minimum": 1 }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["manual", "service_manual", "mechanic", "photo", "spec"] },
        "ref": { "$ref": "#/definitions/slug" },
        "page": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "type": { "enum": ["manual", "service_manual"] } } },
      "then": { "required": ["page"] }
    },
    "tip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "text", "source"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": {
          "allOf": [
            { "$ref": "#/definitions/source" },
            { "type": "object", "properties": { "type": { "const": "mechanic" } } }
          ]
        }
      }
    },
    "outcome": {
      "oneOf": [
        { "type": "string", "pattern": "^s[0-9]+$", "description": "next step id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolve"],
          "properties": { "resolve": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["escalate"],
          "properties": { "escalate": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "source", "hazard", "on_pass", "on_fail"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$" },
        "check": { "type": "string", "minLength": 1 },
        "how": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/source" },
        "hazard": { "type": "boolean" },
        "tip": { "$ref": "#/definitions/tip" },
        "conflict": {
          "description": "Manual and mechanic tip disagree; both are kept, manual shown first.",
          "type": "boolean"
        },
        "on_pass": { "$ref": "#/definitions/outcome" },
        "on_fail": { "$ref": "#/definitions/outcome" }
      }
    }
  }
}
