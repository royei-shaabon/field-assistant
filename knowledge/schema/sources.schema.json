{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sources.schema.json",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "date"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "type": {
            "enum": ["manual", "service_manual", "mechanic", "photo", "spec"],
            "description": "spec = an illustrative example from docs/spec.md; only for sample: true"
          },
          "title": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "file": { "type": "string", "description": "Path under sources/ (git-ignored)" },
          "notes": { "type": "string" },
          "sample": { "type": "boolean" }
        }
      }
    }
  }
}
