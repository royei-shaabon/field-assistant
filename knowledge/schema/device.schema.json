{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "device.schema.json",
  "title": "Device covered by the knowledge base",
  "type": "object",
  "additionalProperties": false,
  "required": ["make", "model_name", "model_code", "year", "manual_version", "verified"],
  "properties": {
    "make": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "model_code": { "type": ["string", "null"] },
    "year": { "type": ["integer", "null"], "minimum": 2000 },
    "manual_version": { "type": ["string", "null"] },
    "verified": {
      "description": "true only after model code and year were confirmed from the registration or VIN",
      "type": "boolean"
    },
    "notes": { "type": "string" }
  }
}
