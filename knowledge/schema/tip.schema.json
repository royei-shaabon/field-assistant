{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tip.schema.json",
  "title": "Field tip recorded in the app, waiting for veteran approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "symptom_id", "author", "recorded_at", "text", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "symptom_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "step_id": { "type": ["string", "null"], "pattern": "^s[0-9]+$" },
    "author": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "transcript": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "approved", "rejected"] },
    "sample": { "type": "boolean" }
  },
  "if": { "properties": { "status": { "const": "approved" } } },
  "then": { "required": ["step_id"], "properties": { "step_id": { "type": "string" } } }
}
